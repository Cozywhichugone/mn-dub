# --- Яриа таних (Whisper) -------------------------------------------
# Локал горим сонговол шаардлагагүй
OPENAI_API_KEY=sk-...

# --- Орчуулга (Claude) ----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...
TRANSLATE_MODEL=claude-sonnet-5

# --- Монгол хоолой (Azure AI Speech) --------------------------------
AZURE_SPEECH_KEY=...
AZURE_SPEECH_REGION=southeastasia

# --- Нэмэлт ----------------------------------------------------------
PORT=5000
MAX_UPLOAD_GB=8

# Локал Whisper ашиглах үед
# WHISPER_MODEL=large-v3
# WHISPER_DEVICE=auto
# WHISPER_COMPUTE=int8
